rules_version = '2';

// Cloud Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos - users can read any profile photo, but only upload to their own folder
    match /profile-photos/{userId}/{fileName} {
      allow read: if true; // Anyone can read profile photos (they are public)
      allow write: if request.auth != null && request.auth.uid == userId; // Only the owner can upload
      allow delete: if request.auth != null && request.auth.uid == userId; // Only the owner can delete

      // File validation
      allow write: if request.resource.size < 2 * 1024 * 1024 // Max 2MB
                   && request.resource.contentType.matches('image/.*'); // Only images
    }

    // Default: deny all access to other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
