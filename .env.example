# Firebase Configuration
NUXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NUXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# AI Provider Configuration
# Choose: 'openai' or 'gemini' (default: gemini - FREE!)
AI_PROVIDER=gemini

# OpenAI Configuration (if using openai)
OPENAI_API_KEY=your_openai_api_key

# Google Gemini Configuration (if using gemini - RECOMMENDED, FREE!)
# Get FREE API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# App Configuration
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin (for server-side) - Choose ONE of these methods:

# Method 1: Path to service account JSON file (RECOMMENDED - easiest)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Method 2: Paste entire service account JSON as string
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Method 3: Individual fields (more complex, not recommended)
# FIREBASE_ADMIN_PROJECT_ID=your-project-id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
